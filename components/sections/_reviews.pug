mixin review(name)
    div.review
        div.text
            span.title Это единственное средство, после которого кожа не раздражается
            span.text Это единственное средство, после которого кожа не раздражается и чувствует себя отлично весь день. Это единственное средство, после которого кожа не раздражается и чувствует себя отлично весь день
            div(onclick="this.closest('div.text').classList.toggle('show')").link
                span.link.show Читать весь комментарий
                span.link.hide Свернуть комментарий
                img(src="images/heart.svg")
        div.author
            img(src="images/7.webp", alt="Мария Петрова").preview
            div.group
                span.name Мария Петрова
                span.detaiil Постоянная покупательница, чувствительная кожа
                div.stars
                    div.star
                        include ../../images/star.svg
                    div.star
                        include ../../images/star.svg
                    div.star
                        include ../../images/star.svg
                    div.star.half
                        include ../../images/star.svg
                    div.star.empty
                        include ../../images/star.svg

section.reviews
    div.container

        div.title
            h2 Женщины доверяют #[br]Intimed каждый день
            div.swiper-navigation
                div.arrow
                    include ../../images/swiper_arrow.svg
                div.arrow
                    include ../../images/swiper_arrow.svg

        div.swiper
            div.swiper-wrapper
                div.swiper-slide
                    div.review.big
                        div.text
                            h3 «Это единственное средство,после которого кожа не раздражается и чувствует себя отлично весь день»
                        div.author
                            img(src="images/7.webp", alt="Мария Петрова").preview
                            div.group
                                span.name Мария Петрова
                                span.detaiil Постоянная покупательница, чувствительная кожа
                                div.stars
                                    div.star
                                        include ../../images/star.svg 
                                    div.star
                                        include ../../images/star.svg
                                    div.star
                                        include ../../images/star.svg
                                    div.star.half
                                        include ../../images/star.svg
                                    div.star.empty
                                        include ../../images/star.svg
                div.swiper-slide
                    +review('Мария Петрова')
                div.swiper-slide
                    +review('Мария Петрова')
                div.swiper-slide
                    +review('Мария Петрова')
                div.swiper-slide
                    +review('Мария Петрова')
                div.swiper-slide
                    +review('Мария Петрова')

        div.swiper-pagination










