extends ../components/common/pug/_layout.pug
include ../components/common/pug/_mixins.pug

block links
    link(rel="stylesheet", href="css/404.css")

block content

    section.error
        div.container

            div.preview
                img(src="images/404_back.svg").bg
                img(src="images/404.svg")
            div.text
                h2 Что-то пошло не так
                span Страница которую Вы запрашиваете не существует, или перенесена в архив. Попробуйте продолжить с главной страницы.
            a(href="#").button 
                span На главную
                include ../images/button_arrow.svg
